ENV=production
PORT=4000

# Telegram API Credentials (get from https://my.telegram.org)
TG_API_ID=
TG_API_HASH=
ADMIN_USERNAME=

# Database Configuration
# For Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# For local: postgresql://postgres@localhost:5432/teledrive
DATABASE_URL=postgresql://postgres@localhost:5432/teledrive

# Optional: Redis Cache (for better performance)
# For Upstash: rediss://default:[PASSWORD]@[HOST].upstash.io:6379
# For Vercel KV: will use @vercel/kv automatically if not set
# Leave empty to disable caching
REDIS_URI=

# Optional: Maintenance mode
IS_MAINTENANCE=

# File cache settings
CACHE_FILES_LIMIT=20GB

# Optional: Error reporting via Telegram Bot
TG_BOT_TOKEN=
TG_BOT_ERROR_REPORT_ID=
TG_BOT_OWNER_ID=

# Vercel deployment flag (auto-set by Vercel)
# VERCEL=1
